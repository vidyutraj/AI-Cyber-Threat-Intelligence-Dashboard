# Copy this file to `.env` and fill in your values.
# Do not commit your real `.env` file.

# Required for AI-powered endpoints (brief + chat + embeddings)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional model override
OPENAI_MODEL=gpt-4o-mini

# Optional MalwareBazaar API key (malware feed still runs without it)
MALWAREBAZAAR_API_KEY=your-malwarebazaar-key-here

# Optional backend tuning
SCRAPE_INTERVAL_SECONDS=900
INCIDENT_BRIEF_TEMPERATURE=0.4
INCIDENT_BRIEF_TTL_SECONDS=600

# Optional frontend override for API URL
# Leave empty to use same-origin in local dev
VITE_API_BASE=
